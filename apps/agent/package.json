{
	"name": "agent",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"backfill:images": "bun scripts/backfill-brand-images.ts",
		"contracts:sync": "bun scripts/sync-contracts-drive.ts",
		"contracts:reconcile": "bun scripts/reconcile-contracts.ts",
		"support:sync": "bun scripts/sync-support-data.ts",
		"dev": "eve dev --no-ui",
		"dev:tui": "eve dev",
		"dispatch": "curl -fsS -X POST \"${AGENT_URL:-http://127.0.0.1:2000}/eve/v1/dev/schedules/dispatch\"",
		"build": "eve build",
		"start": "eve start",
		"check-types": "tsc --noEmit",
		"test": "bun test",
		"lint": "biome check .",
		"clean": "rm -rf .turbo .eve node_modules"
	},
	"dependencies": {
		"@crm/db": "workspace:*",
		"@crm/env": "workspace:*",
		"context.dev": "^2.7.0",
		"eve": "^0.29.4",
		"mammoth": "^1.12.1",
		"unpdf": "^1.8.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@types/node": "^24.0.0",
		"microsandbox": "^0.6.8",
		"typescript": "^5.9.2"
	}
}
