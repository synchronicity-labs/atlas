 def check_cron_logs():
     """WARN if the most recent output in a cron log looks like a failure.
     Looks only at the tail so old/recovered errors don't linger as false alarms."""
     try:
         cron = subprocess.run(["crontab", "-l"], capture_output=True, text=True).stdout
     except Exception:
         return
     logs = sorted(set(re.findall(r'>> ?([A-Za-z0-9_./-]+\.log)', cron)))
     sig = re.compile(r'Traceback \(most recent call last\)|^ERROR:|HTTPError|ModuleNotFoundError|ImportError', re.M)
     for lg in logs:
         try:
             with open(lg) as fh:
                 tail = "".join(fh.readlines()[-8:])
         except Exception:
             continue
         if sig.search(tail):
             hit = next((l for l in tail.splitlines() if sig.search(l)), "")
