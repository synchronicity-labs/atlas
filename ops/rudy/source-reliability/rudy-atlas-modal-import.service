[Unit]
Description=Import aggregate Modal billing into Atlas
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
UMask=0077
ExecStart=/usr/local/sbin/rudy-atlas-modal-import
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
