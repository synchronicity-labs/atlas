{
	"name": "atlas",
	"private": true,
	"license": "MIT",
	"version": "1.0.0",
	"scripts": {
		"build": "turbo run build",
		"dev": "doppler run -- turbo run dev",
		"dev:env": "turbo run dev",
		"lint": "turbo run lint",
		"format": "biome format --write .",
		"check-types": "turbo run check-types",
		"test": "turbo run test",
		"release:check": "bun ops/release/check.ts",
		"release:test": "bun test ops/release",
		"auth:generate": "doppler run -- turbo run auth:generate",
		"db:deploy": "doppler run -- turbo run db:deploy",
		"db:generate": "doppler run -- turbo run db:generate",
		"db:migrate": "doppler run -- turbo run db:migrate",
		"db:push": "doppler run -- turbo run db:push",
		"db:reset": "doppler run -- turbo run db:reset",
		"db:seed": "doppler run -- turbo run db:seed",
		"db:studio": "doppler run -- turbo run db:studio",
		"metabase:users": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/metabase/users'",
		"metabase:sync": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/metabase/incremental'",
		"metabase:backfill": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/metabase/backfill'",
		"marketing:sync": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/marketing'",
		"catalog:sync": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/metric-catalog'",
		"abuse:sync": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/atlas/5'",
		"modal:import:rudy": "doppler run -- bun apps/agent/scripts/import-rudy-modal-costs.ts",
		"economics:sync": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/atlas/6'",
		"customer:sync": "doppler run -- bun apps/agent/scripts/sync-customer-data.ts",
		"contracts:sync": "doppler run -- bun apps/agent/scripts/sync-contracts-drive.ts",
		"contracts:reconcile": "doppler run -- bun apps/agent/scripts/reconcile-contracts.ts",
		"contracts:dashboard": "doppler run -- sh -c 'curl -fsS -X POST -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3001/internal/sync/atlas/13/native'",
		"hubspot:sales:sync": "doppler run -- bun apps/agent/scripts/sync-hubspot-sales.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"turbo": "^2.10.8",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "bun@1.3.12",
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.12"
		}
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
