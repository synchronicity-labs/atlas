datasource db {
  provider = "postgresql"
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedCompanies Company[]           @relation("CompanyOwner")
  ownedContacts  Contact[]           @relation("ContactOwner")
  ownedDeals     Deal[]              @relation("DealOwner")
  activities     Activity[]          @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[]       @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  rudySessions   RudySession[]

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  HUBSPOT
}

enum DataSourceKind {
  METABASE
  STRIPE
  HUBSPOT
  POSTHOG
  ATLAS
}

enum ExternalRecordKind {
  COMPANY
  CONTACT
  PERSON
  DEAL
  PIPELINE
  OWNER
  ACTIVITY
}

enum IdentityLinkMethod {
  EXACT_EXTERNAL_ID
  EXACT_EMAIL
  EXACT_DOMAIN
  SOURCE_ASSOCIATION
  MEMBER_DOMAIN
}

enum SourceStatus {
  UNCONFIGURED
  SYNCING
  HEALTHY
  STALE
  ERROR
}

enum SyncMode {
  INCREMENTAL
  BACKFILL
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum QueryLanguage {
  SQL
  MBQL
  API
}

enum QuestionStatus {
  ACTIVE
  ARCHIVED
}

enum VisualizationType {
  NUMBER
  LINE
  AREA
  BAR
  PIE
  TABLE
  FUNNEL
  TEXT
}

model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String? @unique
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  contacts                 Contact[]                        @relation("CompanyContacts")
  conversations            AgentConversation[]
  deals                    Deal[]
  activities               Activity[]
  emailThreads             EmailThread[]
  calendarEvents           CalendarEvent[]
  sourceRecords            SourceRecord[]
  productUserLinks         ProductUserCompanyLink[]
  productOrganizationLinks ProductOrganizationCompanyLink[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@map("company")
}

model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String? @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  deals            DealContact[]
  activities       Activity[]
  emailThreads     EmailThread[]
  calendarEvents   CalendarEvent[]
  eventAttendance  CalendarAttendee[]
  sourceRecords    SourceRecord[]
  productUserLinks ProductUserContactLink[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@map("contact")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
}

model AgentTask {
  id            String       @id @default(cuid())
  contactId     String?
  companyId     String?
  productUserId String?
  productUser   ProductUser? @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  kind   String
  reason String

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([productUserId])
  @@map("agentTask")
}

model AgentEvent {
  id        String  @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
}

model AgentConversation {
  id String @id @default(cuid())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  atlasContextKind String?
  atlasContextId   String?

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  sessionId         String  @unique
  continuationToken String?
  streamIndex       Int     @default(0)

  title        String?
  messageCount Int     @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([atlasContextKind, atlasContextId, lastMessageAt])
  @@map("agentConversation")
}

model RudySession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contextKind String
  contextId   String

  hermesSessionId String @unique
  title           String?
  messageCount    Int    @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([userId, contextKind, contextId, lastMessageAt])
  @@map("rudySession")
}

model Deal {
  id            String              @id @default(cuid())
  conversations AgentConversation[]
  name          String
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                @relation("DealOwner", fields: [ownerId], references: [id])

  stage             DealStage @default(DEMO_BOOKED)
  stageChangedAt    DateTime  @default(now())
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?

  lastActivityAt DateTime?

  contacts   DealContact[]
  activities Activity[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@map("deal")
}

model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String?

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("dealContact")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  occurredAt  DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  meta        Json?

  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([createdById])
  @@map("activity")
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  NEEDS_RECONNECT
  FAILED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String

  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
}

model EmailThread {
  id            String  @id @default(cuid())
  rootMessageId String  @unique
  subject       String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  rfcMessageId   String  @unique
  syncedByUserId String?
  gmailMessageId String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  recipients Json
  subject    String?
  snippet    String?
  body       String?
  sentAt     DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
}

model CalendarEvent {
  id                String   @id @default(cuid())
  iCalUid           String
  originalStartTime DateTime
  recurringEventId  String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
}

model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
}

model SuppressedContact {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedContact")
}

model AppSetting {
  id String @id

  agentModelId String?

  agentModelContextWindow Int?

  contextDevApiKey String?

  updatedAt DateTime @updatedAt

  @@map("appSetting")
}

model DataSource {
  id                  String         @id @default(cuid())
  key                 String         @unique
  kind                DataSourceKind
  label               String
  state               SourceStatus   @default(UNCONFIGURED)
  lastSyncAt          DateTime?
  lastError           String?
  freshnessDeadlineAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  dashboards            SourceDashboard[]
  cards                 SourceCard[]
  syncRuns              SyncRun[]
  syncCursors           SyncCursor[]
  resultSnapshots       ResultSnapshot[]
  questions             Question[]
  productUsers          ProductUser[]
  productOrganizations  ProductOrganization[]
  productUserSnapshots  ProductUserSnapshot[]
  sourceRecords         SourceRecord[]
  sourceRecordSnapshots SourceRecordSnapshot[]

  @@map("dataSource")
}

model SourceDashboard {
  id           String     @id @default(cuid())
  sourceId     String
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String
  name         String
  description  String?
  tabs         Json
  metadataHash String
  metadata     Json?
  syncedAt     DateTime

  cards SourceCard[]

  @@unique([sourceId, externalId])
  @@index([sourceId, syncedAt])
  @@map("sourceDashboard")
}

model SourceCard {
  id                 String          @id @default(cuid())
  sourceId           String
  source             DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  dashboardId        String
  dashboard          SourceDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  externalId         String
  dashcardExternalId String
  tabExternalId      String?
  name               String
  description        String?
  display            String
  queryType          String?
  databaseExternalId String?
  metadata           Json
  syncedAt           DateTime

  @@unique([sourceId, dashcardExternalId])
  @@index([sourceId, externalId])
  @@index([dashboardId, tabExternalId])
  @@map("sourceCard")
}

model SyncRun {
  id               String        @id @default(cuid())
  runKey           String        @unique
  sourceId         String
  source           DataSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mode             SyncMode
  status           SyncRunStatus @default(RUNNING)
  scope            String
  period           String
  cardsProcessed   Int           @default(0)
  snapshotsCreated Int           @default(0)
  recordsProcessed Int           @default(0)
  checkpoint       Json?
  error            String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?

  @@index([sourceId, startedAt])
  @@map("syncRun")
}

model SyncCursor {
  id               String     @id @default(cuid())
  sourceId         String
  source           DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mode             SyncMode
  scope            String
  period           String
  offset           Int        @default(0)
  cursor           String?
  completedPeriods Int        @default(0)
  updatedAt        DateTime   @updatedAt

  @@unique([sourceId, mode, scope])
  @@map("syncCursor")
}

model ResultSnapshot {
  id                  String     @id @default(cuid())
  idempotencyKey      String     @unique
  sourceId            String
  source              DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  dashboardExternalId String?
  questionExternalId  String
  reportingPeriod     String
  capturedAt          DateTime
  contentHash         String
  columns             Json
  rows                Json
  rowCount            Int
  createdAt           DateTime   @default(now())

  @@index([questionExternalId, reportingPeriod, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("resultSnapshot")
}

model Question {
  id                        String         @id @default(cuid())
  number                    Int            @unique
  name                      String
  description               String?
  connector                 DataSourceKind
  sourceId                  String?
  source                    DataSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceExternalId          String?
  sourceDashboardExternalId String?
  databaseExternalId        String?
  status                    QuestionStatus @default(ACTIVE)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  versions        QuestionVersion[]
  dashboardCards  DashboardCard[]
  changeProposals QuestionChangeProposal[]

  @@unique([connector, sourceExternalId])
  @@index([status, updatedAt])
  @@map("question")
}

model QuestionChangeProposal {
  id            String        @id @default(cuid())
  questionId    String
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId     String
  summary       String
  name          String
  description   String?
  queryLanguage QueryLanguage
  queryText     String
  display       String
  visualization Json
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  @@index([questionId, status, createdAt])
  @@index([sessionId, createdAt])
  @@map("questionChangeProposal")
}

model QuestionVersion {
  id                   String        @id @default(cuid())
  questionId           String
  question             Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version              Int
  queryLanguage        QueryLanguage
  queryText            String
  display              String
  visualization        Json
  sourceCardExternalId String?
  createdBy            String
  createdAt            DateTime      @default(now())

  @@unique([questionId, version])
  @@index([questionId, createdAt])
  @@map("questionVersion")
}

model Dashboard {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  description   String?
  layoutVersion Int      @default(1)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tabs  DashboardTab[]
  cards DashboardCard[]

  @@map("dashboard")
}

model DashboardTab {
  id               String    @id @default(cuid())
  dashboardId      String
  dashboard        Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  number           Int
  name             String
  position         Int
  sourceExternalId String?

  cards DashboardCard[]

  @@unique([dashboardId, number])
  @@index([dashboardId, position])
  @@map("dashboardTab")
}

model DashboardCard {
  id              String            @id @default(cuid())
  dashboardId     String
  dashboard       Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  tabId           String?
  tab             DashboardTab?     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position        Int
  x               Int
  y               Int
  width           Int
  height          Int
  visualization   VisualizationType
  displaySettings Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([dashboardId, position])
  @@index([tabId, position])
  @@index([questionId])
  @@map("dashboardCard")
}

model ProductUser {
  id              String     @id @default(cuid())
  sourceId        String
  source          DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  email           String?
  displayName     String?
  role            String?
  disabled        Boolean?
  banned          Boolean?
  isAnonymous     Boolean?
  avatarUrl       String?
  locale          String?
  phoneNumber     String?
  emailVerified   Boolean?
  createdAtSource DateTime?
  updatedAtSource DateTime?
  lastSeenAt      DateTime?
  traits          Json
  syncedAt        DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  identities   ProductUserIdentity[]
  memberships  ProductOrganizationMembership[]
  snapshots    ProductUserSnapshot[]
  sourceLinks  ProductUserSourceLink[]
  contactLinks ProductUserContactLink[]
  companyLinks ProductUserCompanyLink[]
  agentTasks   AgentTask[]

  @@unique([sourceId, externalId])
  @@index([email])
  @@index([displayName])
  @@index([lastSeenAt])
  @@index([externalId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_externalId_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_email_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_displayName_trgm_idx")
  @@index([role(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_role_trgm_idx")
  @@map("productUser")
}

model ProductUserIdentity {
  id              String      @id @default(cuid())
  productUserId   String
  productUser     ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  kind            String
  value           String
  normalizedValue String
  source          String
  createdAt       DateTime    @default(now())

  @@unique([productUserId, kind, normalizedValue])
  @@index([normalizedValue])
  @@index([normalizedValue(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUserIdentity_normalizedValue_trgm_idx")
  @@map("productUserIdentity")
}

model ProductOrganization {
  id                   String     @id @default(cuid())
  sourceId             String
  source               DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId           String
  name                 String?
  domain               String?
  plan                 String?
  paymentStatus        Json?
  stripeSubscriptionId String?
  stripeCustomerId     String?
  traits               Json
  syncedAt             DateTime
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  memberships  ProductOrganizationMembership[]
  companyLinks ProductOrganizationCompanyLink[]

  @@unique([sourceId, externalId])
  @@index([name])
  @@index([domain])
  @@index([stripeCustomerId])
  @@index([externalId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_externalId_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_name_trgm_idx")
  @@index([domain(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_domain_trgm_idx")
  @@index([stripeCustomerId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_stripeCustomerId_trgm_idx")
  @@map("productOrganization")
}

model ProductOrganizationMembership {
  id                    String              @id @default(cuid())
  productUserId         String
  productUser           ProductUser         @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  productOrganizationId String
  productOrganization   ProductOrganization @relation(fields: [productOrganizationId], references: [id], onDelete: Cascade)
  role                  String?
  traits                Json?
  syncedAt              DateTime

  @@unique([productUserId, productOrganizationId])
  @@index([productOrganizationId])
  @@map("productOrganizationMembership")
}

model ProductUserSnapshot {
  id             String      @id @default(cuid())
  idempotencyKey String      @unique
  sourceId       String
  source         DataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productUserId  String
  productUser    ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  capturedAt     DateTime
  contentHash    String
  payload        Json
  createdAt      DateTime    @default(now())

  @@index([productUserId, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("productUserSnapshot")
}

model SourceRecord {
  id              String             @id @default(cuid())
  sourceId        String
  source          DataSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  kind            ExternalRecordKind
  externalId      String
  companyId       String?
  company         Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contentHash     String
  payload         Json
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  syncedAt        DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  snapshots        SourceRecordSnapshot[]
  productUserLinks ProductUserSourceLink[]

  @@unique([sourceId, kind, externalId])
  @@index([companyId])
  @@index([contactId])
  @@index([sourceId, syncedAt])
  @@map("sourceRecord")
}

model SourceRecordSnapshot {
  id             String       @id @default(cuid())
  idempotencyKey String       @unique
  sourceId       String
  source         DataSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRecordId String
  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  capturedAt     DateTime
  contentHash    String
  payload        Json
  createdAt      DateTime     @default(now())

  @@index([sourceRecordId, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("sourceRecordSnapshot")
}

model ProductUserSourceLink {
  id             String             @id @default(cuid())
  productUserId  String
  productUser    ProductUser        @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  sourceRecordId String
  sourceRecord   SourceRecord       @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  method         IdentityLinkMethod
  confidence     Float
  evidence       Json
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([productUserId, sourceRecordId])
  @@index([sourceRecordId])
  @@map("productUserSourceLink")
}

model ProductUserContactLink {
  id            String             @id @default(cuid())
  productUserId String
  productUser   ProductUser        @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  method        IdentityLinkMethod
  confidence    Float
  evidence      Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productUserId, contactId])
  @@index([contactId])
  @@map("productUserContactLink")
}

model ProductUserCompanyLink {
  id            String             @id @default(cuid())
  productUserId String
  productUser   ProductUser        @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  method        IdentityLinkMethod
  confidence    Float
  evidence      Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([productUserId, companyId])
  @@index([companyId])
  @@map("productUserCompanyLink")
}

model ProductOrganizationCompanyLink {
  id                    String              @id @default(cuid())
  productOrganizationId String
  productOrganization   ProductOrganization @relation(fields: [productOrganizationId], references: [id], onDelete: Cascade)
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  method                IdentityLinkMethod
  confidence            Float
  evidence              Json
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([productOrganizationId, companyId])
  @@index([companyId])
  @@map("productOrganizationCompanyLink")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  website     String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("organization")
}

model WorkspaceProfile {
  id String @id

  website   String
  narrative String
  sections  Json

  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("workspaceProfile")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
}
