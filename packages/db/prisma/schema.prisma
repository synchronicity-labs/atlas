  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  snapshots        SourceRecordSnapshot[]
  productUserLinks ProductUserSourceLink[]

  @@unique([sourceId, kind, externalId])
  @@index([companyId])
  @@index([contactId])
  @@index([sourceId, syncedAt])
  @@map("sourceRecord")
