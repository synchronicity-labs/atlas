  sourceRecord   SourceRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)
  capturedAt     DateTime
  contentHash    String
  payload        Json
  createdAt      DateTime     @default(now())

  @@index([sourceRecordId, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("sourceRecordSnapshot")
  @@schema("public")
}

model ProductUserSourceLink {
