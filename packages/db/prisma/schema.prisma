  sourceId         String
  source           DataSource                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  billingCountryId String
  billingCountry   StripeCustomerBillingCountry @relation(fields: [billingCountryId], references: [id], onDelete: Cascade)
  stripeCustomerId String
  countryCode      String
  evidenceKind     String
  sourceExternalId String
  observedAt       DateTime
  dataThrough      DateTime
  capturedAt       DateTime
  contentHash      String
  payload          Json
  createdAt        DateTime                     @default(now())

  @@index([billingCountryId, capturedAt])
  @@index([sourceId, capturedAt])
  @@index([stripeCustomerId, observedAt])
  @@map("stripeCustomerBillingCountrySnapshot")
  @@schema("public")
}

model SourceRecord {
  id              String             @id @default(cuid())
