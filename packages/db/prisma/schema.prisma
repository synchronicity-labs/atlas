datasource db {
  provider = "postgresql"
  schemas  = ["public", "ingestion", "core", "metrics", "atlas_app"]
}

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = ""
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  ownedCompanies Company[]           @relation("CompanyOwner")
  ownedContacts  Contact[]           @relation("ContactOwner")
  ownedDeals     Deal[]              @relation("DealOwner")
  activities     Activity[]          @relation("ActivityAuthor")
  mailboxSyncs   MailboxSync[]
  factDecisions  ContactFact[]       @relation("FactDecider")
  conversations  AgentConversation[] @relation("ConversationOwner")
  rudySessions   RudySession[]

  members     Member[]
  invitations Invitation[]

  ssoproviders SsoProvider[]

  @@unique([email])
  @@map("user")
  @@schema("public")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
  @@schema("public")
}

enum DealStage {
  DEMO_BOOKED
  QUALIFIED_TO_BUY
  UNQUALIFIED_TO_BUY
  DECISION_MAKER_BOUGHT_IN
  CONTRACT_SENT
  CLOSED_WON
  CLOSED_LOST

  @@schema("public")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  TASK
  STAGE_CHANGE
  ENRICHMENT

  @@schema("public")
}

enum EnrichmentStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  SKIPPED

  @@schema("public")
}

enum RecordSource {
  MANUAL
  IMPORT
  EMAIL
  CALENDAR
  HUBSPOT

  @@schema("public")
}

enum RevenueDoor {
  TOOLS
  PARTNERS
  PRODUCTIONS
  ENTERPRISE
  PROGRAM

  @@schema("public")
}

enum RevenueDoorMatchKind {
  PLAN
  EMAIL_DOMAIN
  ORGANIZATION_ID
  STRIPE_CUSTOMER_ID

  @@schema("public")
}

enum RevenueDoorPolicyStatus {
  PARTIAL
  COMPLETE

  @@schema("public")
}

enum DataSourceKind {
  METABASE
  POSTGRES
  TINYBIRD
  STRIPE
  HUBSPOT
  POSTHOG
  GOOGLE_ANALYTICS
  GOOGLE_SEARCH_CONSOLE
  GOOGLE_SHEETS
  ATLAS

  @@schema("public")
}

enum ExternalRecordKind {
  COMPANY
  CONTACT
  PERSON
  DEAL
  PIPELINE
  OWNER
  ACTIVITY

  @@schema("public")
}

enum IdentityLinkMethod {
  EXACT_EXTERNAL_ID
  EXACT_EMAIL
  EXACT_DOMAIN
  SOURCE_ASSOCIATION
  MEMBER_DOMAIN

  @@schema("public")
}

enum SourceStatus {
  UNCONFIGURED
  SYNCING
  HEALTHY
  STALE
  ERROR

  @@schema("public")
}

enum SyncMode {
  INCREMENTAL
  BACKFILL

  @@schema("public")
}

enum SyncRunStatus {
  RUNNING
  COMPLETED
  FAILED

  @@schema("public")
}

enum QueryLanguage {
  SQL
  MBQL
  API

  @@schema("public")
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("public")
}

enum QuestionPurpose {
  CERTIFIED
  EXPLORATORY
  RECONCILIATION

  @@schema("public")
}

enum VisualizationType {
  NUMBER
  LINE
  AREA
  BAR
  PIE
  TABLE
  FUNNEL
  TEXT

  @@schema("public")
}

enum FactGrain {
  EVENT
  DAY
  WEEK
  MONTH
  QUARTER

  @@schema("core")
}

enum MetricLifecycleStatus {
  DRAFT
  CERTIFIED
  DEPRECATED

  @@schema("metrics")
}

enum MetricCatalogKind {
  KPI
  VIEW
  DIAGNOSTIC
  ROADMAP_MEASURE
  UNCLASSIFIED

  @@schema("metrics")
}

enum MetricReadinessStatus {
  CATALOGED
  NEEDS_DEFINITION
  NEEDS_SOURCE
  NEEDS_EVIDENCE
  READY_TO_IMPLEMENT
  IMPLEMENTING
  RECONCILING
  VERIFIED
  BLOCKED

  @@schema("metrics")
}

enum MetricCatalogAttemptOutcome {
  DATA_FOUND
  NO_ROWS
  QUERY_FAILED
  QUERY_NOT_BUILT
  SOURCE_MISSING
  SOURCE_ERROR
  SOURCE_UNKNOWN

  @@schema("metrics")
}

enum MetricRunStatus {
  QUEUED
  RUNNING
  VALIDATING
  PUBLISHED
  FAILED

  @@schema("metrics")
}

enum MetricTrustStatus {
  PENDING
  VERIFIED
  FAILED
  STALE

  @@schema("metrics")
}

enum VerificationStatus {
  PENDING
  PASSED
  FAILED
  WAIVED

  @@schema("metrics")
}

model Company {
  id          String  @id @default(cuid())
  name        String
  domain      String? @unique
  website     String?
  description String?

  logoUrl     String?
  logoDarkUrl String?
  iconUrl     String?
  iconDarkUrl String?
  iconTone    String?
  brandColor  String?

  industry    String?
  subIndustry String?
  city        String?
  stateCode   String?
  country     String?
  countryCode String?

  phone       String?
  email       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  pricingUrl  String?
  careersUrl  String?

  ownerId          String?
  owner            User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryContactId String?  @unique
  primaryContact   Contact? @relation("PrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  enrichmentStatus EnrichmentStatus   @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?
  enrichment       CompanyEnrichment?

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  contacts                 Contact[]                        @relation("CompanyContacts")
  conversations            AgentConversation[]
  deals                    Deal[]
  activities               Activity[]
  emailThreads             EmailThread[]
  calendarEvents           CalendarEvent[]
  sourceRecords            SourceRecord[]
  productUserLinks         ProductUserCompanyLink[]
  productOrganizationLinks ProductOrganizationCompanyLink[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([ownerId])
  @@index([name])
  @@index([lastActivityAt])
  @@map("company")
  @@schema("public")
}

model CompanyEnrichment {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source    String   @default("context.dev")
  raw       Json
  fetchedAt DateTime @default(now())

  @@map("companyEnrichment")
  @@schema("public")
}

model Contact {
  id          String  @id @default(cuid())
  firstName   String
  lastName    String?
  email       String? @unique
  phone       String?
  title       String?
  linkedinUrl String?
  twitterUrl  String?
  githubUrl   String?
  imageUrl    String?

  socialsCheckedAt DateTime?

  enrichmentStatus EnrichmentStatus @default(PENDING)
  enrichedAt       DateTime?
  enrichmentError  String?

  brief         ContactBrief?
  facts         ContactFact[]
  conversations AgentConversation[]

  companyId String?
  company   Company? @relation("CompanyContacts", fields: [companyId], references: [id], onDelete: SetNull)
  ownerId   String?
  owner     User?    @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  primaryOf Company? @relation("PrimaryContact")

  source RecordSource @default(MANUAL)

  lastActivityAt DateTime?

  deals            DealContact[]
  activities       Activity[]
  emailThreads     EmailThread[]
  calendarEvents   CalendarEvent[]
  eventAttendance  CalendarAttendee[]
  sourceRecords    SourceRecord[]
  productUserLinks ProductUserContactLink[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@map("contact")
  @@schema("public")
}

enum FactBand {
  VERIFIED
  PROBABLE
  POSSIBLE

  @@schema("public")
}

enum FactStatus {
  APPLIED
  PROPOSED
  DISMISSED
  SUPERSEDED

  @@schema("public")
}

model ContactFact {
  id        String  @id @default(cuid())
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  field String
  value String

  score Float
  band  FactBand

  evidence Json

  method    String
  sourceUrl String?

  sessionId String?

  status      FactStatus @default(PROPOSED)
  decidedById String?
  decidedBy   User?      @relation("FactDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  observedAt   DateTime  @default(now())
  supersededAt DateTime?

  @@index([contactId, field, status])
  @@index([status, observedAt])
  @@map("contactFact")
  @@schema("public")
}

model ContactBrief {
  contactId String  @id
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  narrative String
  sections  Json

  score     Float
  sourceUrl String?
  sessionId String?

  refreshedAt DateTime @default(now())

  @@map("contactBrief")
  @@schema("public")
}

model AgentTask {
  id            String       @id @default(cuid())
  contactId     String?
  companyId     String?
  productUserId String?
  productUser   ProductUser? @relation(fields: [productUserId], references: [id], onDelete: Cascade)

  kind   String
  reason String

  priority Int @default(0)
  budget   Int @default(4)
  attempts Int @default(0)

  dueAt       DateTime
  leasedUntil DateTime?

  sessionId  String?
  startedAt  DateTime?
  finishedAt DateTime?
  outcome    String?

  createdAt DateTime @default(now())

  @@index([dueAt, leasedUntil])
  @@index([contactId])
  @@index([productUserId])
  @@map("agentTask")
  @@schema("public")
}

model AgentEvent {
  id        String  @id
  sessionId String
  contactId String?
  type      String
  data      Json

  emittedAt DateTime

  @@index([sessionId, emittedAt])
  @@index([contactId, emittedAt])
  @@map("agentEvent")
  @@schema("public")
}

model AgentConversation {
  id String @id @default(cuid())

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  atlasContextKind String?
  atlasContextId   String?

  userId String
  user   User   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  sessionId         String  @unique
  continuationToken String?
  streamIndex       Int     @default(0)

  title        String?
  messageCount Int     @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([contactId, lastMessageAt])
  @@index([companyId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([atlasContextKind, atlasContextId, lastMessageAt])
  @@map("agentConversation")
  @@schema("public")
}

model RudySession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contextKind String
  contextId   String

  hermesSessionId String  @unique
  title           String?
  messageCount    Int     @default(0)

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  @@index([userId, contextKind, contextId, lastMessageAt])
  @@map("rudySession")
  @@schema("public")
}

model Deal {
  id            String              @id @default(cuid())
  conversations AgentConversation[]
  name          String
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User                @relation("DealOwner", fields: [ownerId], references: [id])

  stage             DealStage @default(DEMO_BOOKED)
  stageChangedAt    DateTime  @default(now())
  amount            Decimal?  @db.Decimal(14, 2)
  currency          String    @default("USD")
  expectedCloseDate DateTime?
  closedAt          DateTime?
  closedReason      String?

  lastActivityAt DateTime?

  contacts   DealContact[]
  activities Activity[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([lastActivityAt])
  @@map("deal")
  @@schema("public")
}

model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String?

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("dealContact")
  @@schema("public")
}

model Activity {
  id      String       @id @default(cuid())
  type    ActivityType
  subject String?
  body    String?

  occurredAt  DateTime?
  dueAt       DateTime?
  completedAt DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ActivityAuthor", fields: [createdById], references: [id])
  meta        Json?

  emailThreadId   String?        @unique
  emailThread     EmailThread?   @relation(fields: [emailThreadId], references: [id], onDelete: Cascade)
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([dealId, createdAt])
  @@index([contactId, createdAt])
  @@index([dueAt])
  @@index([createdById])
  @@map("activity")
  @@schema("public")
}

enum GoogleSyncStatus {
  IDLE
  RUNNING
  NEEDS_RECONNECT
  FAILED

  @@schema("public")
}

enum EmailDirection {
  INBOUND
  OUTBOUND

  @@schema("public")
}

model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String

  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@map("mailboxSync")
  @@schema("public")
}

model EmailThread {
  id            String  @id @default(cuid())
  rootMessageId String  @unique
  subject       String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages EmailMessage[]
  activity Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@map("emailThread")
  @@schema("public")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  rfcMessageId   String  @unique
  syncedByUserId String?
  gmailMessageId String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  recipients Json
  subject    String?
  snippet    String?
  body       String?
  sentAt     DateTime

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@map("emailMessage")
  @@schema("public")
}

model CalendarEvent {
  id                String   @id @default(cuid())
  iCalUid           String
  originalStartTime DateTime
  recurringEventId  String?

  title          String?
  description    String?
  location       String?
  conferenceUrl  String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean  @default(false)
  status         String
  organizerEmail String?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  syncedByUserId String?
  googleEventId  String?

  attendees CalendarAttendee[]
  activity  Activity?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([iCalUid, originalStartTime])
  @@index([companyId, startsAt])
  @@index([contactId, startsAt])
  @@map("calendarEvent")
  @@schema("public")
}

model CalendarAttendee {
  id      String        @id @default(cuid())
  eventId String
  event   CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  email          String
  name           String?
  responseStatus String?
  isOrganizer    Boolean  @default(false)
  contactId      String?
  contact        Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([contactId])
  @@map("calendarAttendee")
  @@schema("public")
}

model SuppressedDomain {
  domain    String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedDomain")
  @@schema("public")
}

model SuppressedContact {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("suppressedContact")
  @@schema("public")
}

model AppSetting {
  id String @id

  agentModelId String?

  agentModelContextWindow Int?

  contextDevApiKey String?

  updatedAt DateTime @updatedAt

  @@map("appSetting")
  @@schema("public")
}

model DataSource {
  id                  String         @id @default(cuid())
  key                 String         @unique
  kind                DataSourceKind
  label               String
  state               SourceStatus   @default(UNCONFIGURED)
  lastSyncAt          DateTime?
  lastError           String?
  freshnessDeadlineAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  dashboards            SourceDashboard[]
  cards                 SourceCard[]
  syncRuns              SyncRun[]
  syncCursors           SyncCursor[]
  resultSnapshots       ResultSnapshot[]
  questions             Question[]
  productUsers          ProductUser[]
  productOrganizations  ProductOrganization[]
  productUserSnapshots  ProductUserSnapshot[]
  stripeCustomerBillingCountries StripeCustomerBillingCountry[]
  stripeCustomerBillingCountrySnapshots StripeCustomerBillingCountrySnapshot[]
  sourceRecords         SourceRecord[]
  sourceRecordSnapshots SourceRecordSnapshot[]
  ingestionDatasets     IngestionDataset[]
  sourceWatermarks      SourceWatermark[]
  normalizedFacts       NormalizedFact[]
  metricCatalogEntries  MetricCatalogEntry[]

  @@map("dataSource")
  @@schema("public")
}

model SourceDashboard {
  id           String     @id @default(cuid())
  sourceId     String
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId   String
  name         String
  description  String?
  tabs         Json
  metadataHash String
  metadata     Json?
  syncedAt     DateTime

  cards SourceCard[]

  @@unique([sourceId, externalId])
  @@index([sourceId, syncedAt])
  @@map("sourceDashboard")
  @@schema("public")
}

model SourceCard {
  id                 String          @id @default(cuid())
  sourceId           String
  source             DataSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  dashboardId        String
  dashboard          SourceDashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  externalId         String
  dashcardExternalId String
  tabExternalId      String?
  name               String
  description        String?
  display            String
  queryType          String?
  databaseExternalId String?
  metadata           Json
  syncedAt           DateTime

  @@unique([sourceId, dashcardExternalId])
  @@index([sourceId, externalId])
  @@index([dashboardId, tabExternalId])
  @@map("sourceCard")
  @@schema("public")
}

model SyncRun {
  id               String        @id @default(cuid())
  runKey           String        @unique
  sourceId         String
  source           DataSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mode             SyncMode
  status           SyncRunStatus @default(RUNNING)
  scope            String
  period           String
  cardsProcessed   Int           @default(0)
  snapshotsCreated Int           @default(0)
  recordsProcessed Int           @default(0)
  checkpoint       Json?
  attempt          Int           @default(1)
  leaseOwner       String?
  leasedAt         DateTime?
  heartbeatAt      DateTime?
  nextRetryAt      DateTime?
  dataThrough      DateTime?
  error            String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  updatedAt        DateTime      @default(now()) @updatedAt

  sourceWatermarks SourceWatermark[]
  normalizedFacts  NormalizedFact[]

  @@index([sourceId, startedAt])
  @@index([status, nextRetryAt])
  @@index([leaseOwner, leasedAt])
  @@map("syncRun")
  @@schema("public")
}

model SyncCursor {
  id               String     @id @default(cuid())
  sourceId         String
  source           DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  mode             SyncMode
  scope            String
  period           String
  offset           Int        @default(0)
  cursor           String?
  completedPeriods Int        @default(0)
  checkpoint       Json?
  dataThrough      DateTime?
  lastSuccessAt    DateTime?
  updatedAt        DateTime   @updatedAt

  @@unique([sourceId, mode, scope])
  @@map("syncCursor")
  @@schema("public")
}

model IngestionDataset {
  id                  String     @id @default(cuid())
  sourceId            String
  source              DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  key                 String
  label               String
  description         String?
  adapter             String
  eventTimeField      String
  watermarkField      String?
  cadenceMinutes      Int
  freshnessSlaMinutes Int
  backfillWindowDays  Int?
  config              Json
  enabled             Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  watermarks   SourceWatermark[]
  facts        NormalizedFact[]
  metricInputs MetricInput[]

  @@unique([sourceId, key])
  @@index([enabled, cadenceMinutes])
  @@map("dataset")
  @@schema("ingestion")
}

model SourceWatermark {
  id             String           @id @default(cuid())
  idempotencyKey String           @unique
  datasetId      String
  dataset        IngestionDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sourceId       String
  source         DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncRunId      String?
  syncRun        SyncRun?         @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  dataThrough    DateTime
  complete       Boolean          @default(false)
  rowCount       Int?
  contentHash    String?
  checkpoint     Json?
  observedAt     DateTime
  createdAt      DateTime         @default(now())

  @@index([datasetId, dataThrough])
  @@index([sourceId, observedAt])
  @@index([syncRunId])
  @@map("sourceWatermark")
  @@schema("ingestion")
}

model NormalizedFact {
  id             String           @id @default(cuid())
  idempotencyKey String           @unique
  datasetId      String
  dataset        IngestionDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  sourceId       String
  source         DataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  syncRunId      String?
  syncRun        SyncRun?         @relation(fields: [syncRunId], references: [id], onDelete: SetNull)
  entityType     String
  entityId       String
  grain          FactGrain
  periodStart    DateTime
  periodEnd      DateTime
  eventTime      DateTime?
  dataThrough    DateTime
  dimensions     Json
  measures       Json
  eligibility    Json?
  contentHash    String
  createdAt      DateTime         @default(now())

  @@index([datasetId, periodStart, periodEnd])
  @@index([entityType, entityId, periodStart])
  @@index([sourceId, dataThrough])
  @@index([syncRunId])
  @@map("normalizedFact")
  @@schema("core")
}

model MetricDefinition {
  id          String                @id @default(cuid())
  key         String                @unique
  name        String
  description String
  ownerTeam   String
  status      MetricLifecycleStatus @default(DRAFT)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  versions       MetricVersion[]
  catalogEntries MetricCatalogEntry[]

  @@index([status, ownerTeam])
  @@map("metricDefinition")
  @@schema("metrics")
}

model MetricCatalogEntry {
  id               String                @id @default(cuid())
  sourceId         String
  source           DataSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceDocumentId String
  sourceTabId      Int
  sourceTabName    String
  sourceTabIndex   Int
  sourceRange      String
  sourceRow        Int
  externalKey      String
  title            String
  description      String?
  ownerTeam        String?
  sourceHint       String?
  trackability     String?
  kind             MetricCatalogKind     @default(UNCLASSIFIED)
  readiness        MetricReadinessStatus @default(CATALOGED)
  metricId         String?
  metric            MetricDefinition?     @relation(fields: [metricId], references: [id], onDelete: SetNull)
  canonicalQuestionId String?
  canonicalQuestion   Question?            @relation("CatalogCanonicalQuestion", fields: [canonicalQuestionId], references: [id], onDelete: SetNull)
  evidence          MetricCatalogEvidence[]
  attempts          MetricCatalogAttempt[]
  rawRow           Json
  ambiguities      Json
  contentHash      String
  firstSeenAt      DateTime               @default(now())
  lastSeenAt       DateTime
  missingAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([sourceDocumentId, externalKey])
  @@index([kind, readiness])
  @@index([ownerTeam, readiness])
  @@index([metricId])
  @@index([canonicalQuestionId])
  @@index([sourceId, sourceTabIndex, sourceRow])
  @@map("metricCatalogEntry")
  @@schema("metrics")
}

model MetricCatalogAttempt {
  id             String                      @id @default(cuid())
  catalogEntryId String
  catalogEntry   MetricCatalogEntry          @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  runKey         String
  outcome        MetricCatalogAttemptOutcome
  trustStatus    MetricTrustStatus
  detail         String
  observations   Json
  attemptedAt    DateTime                    @default(now())

  @@unique([catalogEntryId, runKey])
  @@index([catalogEntryId, attemptedAt])
  @@index([outcome, trustStatus])
  @@map("metricCatalogAttempt")
  @@schema("metrics")
}

model MetricCatalogEvidence {
  id             String             @id @default(cuid())
  catalogEntryId String
  catalogEntry   MetricCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  questionId     String
  question       Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kind           String             @default("CANDIDATE_RESULT")
  rationale      String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([catalogEntryId, questionId, kind])
  @@index([questionId])
  @@map("metricCatalogEvidence")
  @@schema("metrics")
}

model MetricVersion {
  id                  String           @id @default(cuid())
  metricId            String
  metric              MetricDefinition @relation(fields: [metricId], references: [id], onDelete: Cascade)
  version             Int
  businessDefinition  Json
  normalizationPolicy Json
  computation         Json
  verificationPolicy  Json
  cadence             Json
  contentHash         String
  createdBy           String
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime         @default(now())

  inputs    MetricInput[]
  runs      MetricRun[]
  snapshots MetricSnapshot[]
  questions Question[]

  @@unique([metricId, version])
  @@index([metricId, approvedAt])
  @@map("metricVersion")
  @@schema("metrics")
}

model MetricInput {
  id              String           @id @default(cuid())
  metricVersionId String
  metricVersion   MetricVersion    @relation(fields: [metricVersionId], references: [id], onDelete: Cascade)
  datasetId       String
  dataset         IngestionDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  alias           String
  required        Boolean          @default(true)
  queryLanguage   QueryLanguage
  queryText       String
  queryHash       String
  expectedGrain   FactGrain
  maxLagSeconds   Int
  createdAt       DateTime         @default(now())

  @@unique([metricVersionId, alias])
  @@index([datasetId, metricVersionId])
  @@map("metricInput")
  @@schema("metrics")
}

model MetricRun {
  id               String          @id @default(cuid())
  runKey           String          @unique
  metricVersionId  String
  metricVersion    MetricVersion   @relation(fields: [metricVersionId], references: [id], onDelete: Cascade)
  status           MetricRunStatus @default(QUEUED)
  periodStart      DateTime
  periodEnd        DateTime
  dataThrough      DateTime?
  sourceWatermarks Json
  inputHash        String?
  outputHash       String?
  rowCount         Int             @default(0)
  validation       Json?
  error            String?
  requestedAt      DateTime        @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  snapshot      MetricSnapshot?
  verifications MetricVerification[]

  @@index([metricVersionId, periodStart, periodEnd])
  @@index([status, requestedAt])
  @@map("metricRun")
  @@schema("metrics")
}

model MetricSnapshot {
  id              String            @id @default(cuid())
  idempotencyKey  String            @unique
  metricVersionId String
  metricVersion   MetricVersion     @relation(fields: [metricVersionId], references: [id], onDelete: Cascade)
  metricRunId     String            @unique
  metricRun       MetricRun         @relation(fields: [metricRunId], references: [id], onDelete: Cascade)
  reportingPeriod String
  periodStart     DateTime
  periodEnd       DateTime
  dataThrough     DateTime
  computedAt      DateTime
  trustStatus     MetricTrustStatus @default(PENDING)
  contentHash     String
  columns         Json
  rows            Json
  rowCount        Int
  createdAt       DateTime          @default(now())

  @@index([metricVersionId, reportingPeriod, computedAt])
  @@index([trustStatus, dataThrough])
  @@map("metricSnapshot")
  @@schema("metrics")
}

model MetricVerification {
  id             String             @id @default(cuid())
  metricRunId    String
  metricRun      MetricRun          @relation(fields: [metricRunId], references: [id], onDelete: Cascade)
  name           String
  status         VerificationStatus @default(PENDING)
  referenceType  String
  referenceValue Json?
  actualValue    Json?
  tolerance      Json?
  evidence       Json?
  verifiedBy     String?
  verifiedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@unique([metricRunId, name])
  @@index([status, createdAt])
  @@map("metricVerification")
  @@schema("metrics")
}

model ResultSnapshot {
  id                  String     @id @default(cuid())
  idempotencyKey      String     @unique
  sourceId            String
  source              DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  dashboardExternalId String?
  questionExternalId  String
  reportingPeriod     String
  capturedAt          DateTime
  contentHash         String
  columns             Json
  rows                Json
  rowCount            Int
  createdAt           DateTime   @default(now())

  @@index([questionExternalId, reportingPeriod, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("resultSnapshot")
  @@schema("public")
}

model Question {
  id                        String          @id @default(cuid())
  number                    Int             @unique
  publicNumber              Int             @unique @default(autoincrement())
  name                      String
  description               String?
  connector                 DataSourceKind
  sourceId                  String?
  source                    DataSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceExternalId          String?
  sourceDashboardExternalId String?
  databaseExternalId        String?
  status                    QuestionStatus  @default(ACTIVE)
  purpose                   QuestionPurpose @default(EXPLORATORY)
  metricVersionId           String?
  metricVersion             MetricVersion?  @relation(fields: [metricVersionId], references: [id], onDelete: SetNull)
  lastCheckedAt             DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  versions        QuestionVersion[]
  dashboardCards  DashboardCard[]
  changeProposals QuestionChangeProposal[]
  catalogEvidence MetricCatalogEvidence[]
  canonicalCatalogEntries MetricCatalogEntry[] @relation("CatalogCanonicalQuestion")

  @@unique([connector, sourceExternalId])
  @@index([status, updatedAt])
  @@index([metricVersionId, purpose])
  @@map("question")
  @@schema("public")
}

model QuestionChangeProposal {
  id            String        @id @default(cuid())
  questionId    String
  question      Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sessionId     String
  summary       String
  name          String
  description   String?
  queryLanguage QueryLanguage
  queryText     String
  display       String
  visualization Json
  status        String        @default("PENDING")
  createdAt     DateTime      @default(now())
  reviewedAt    DateTime?

  @@index([questionId, status, createdAt])
  @@index([sessionId, createdAt])
  @@map("questionChangeProposal")
  @@schema("public")
}

model QuestionVersion {
  id                   String        @id @default(cuid())
  questionId           String
  question             Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  version              Int
  queryLanguage        QueryLanguage
  queryText            String
  display              String
  visualization        Json
  sourceCardExternalId String?
  createdBy            String
  createdAt            DateTime      @default(now())

  @@unique([questionId, version])
  @@index([questionId, createdAt])
  @@map("questionVersion")
  @@schema("public")
}

model Dashboard {
  id            String   @id @default(cuid())
  number        Int      @unique
  name          String
  description   String?
  layoutVersion Int      @default(1)
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tabs  DashboardTab[]
  cards DashboardCard[]

  @@map("dashboard")
  @@schema("public")
}

model DashboardTab {
  id               String    @id @default(cuid())
  dashboardId      String
  dashboard        Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  number           Int
  name             String
  position         Int
  sourceExternalId String?

  cards DashboardCard[]

  @@unique([dashboardId, number])
  @@index([dashboardId, position])
  @@map("dashboardTab")
  @@schema("public")
}

model DashboardCard {
  id              String            @id @default(cuid())
  dashboardId     String
  dashboard       Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  tabId           String?
  tab             DashboardTab?     @relation(fields: [tabId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  position        Int
  x               Int
  y               Int
  width           Int
  height          Int
  visualization   VisualizationType
  displaySettings Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([dashboardId, position])
  @@index([tabId, position])
  @@index([questionId])
  @@map("dashboardCard")
  @@schema("public")
}

model ProductUser {
  id              String     @id @default(cuid())
  sourceId        String
  source          DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  email           String?
  displayName     String?
  role            String?
  disabled        Boolean?
  banned          Boolean?
  isAnonymous     Boolean?
  avatarUrl       String?
  locale          String?
  phoneNumber     String?
  emailVerified   Boolean?
  createdAtSource DateTime?
  updatedAtSource DateTime?
  lastSeenAt      DateTime?
  traits          Json
  syncedAt        DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  identities   ProductUserIdentity[]
  memberships  ProductOrganizationMembership[]
  snapshots    ProductUserSnapshot[]
  sourceLinks  ProductUserSourceLink[]
  contactLinks ProductUserContactLink[]
  companyLinks ProductUserCompanyLink[]
  agentTasks   AgentTask[]

  @@unique([sourceId, externalId])
  @@index([email])
  @@index([displayName])
  @@index([lastSeenAt])
  @@index([externalId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_externalId_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_email_trgm_idx")
  @@index([displayName(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_displayName_trgm_idx")
  @@index([role(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUser_role_trgm_idx")
  @@map("productUser")
  @@schema("public")
}

model ProductUserIdentity {
  id              String      @id @default(cuid())
  productUserId   String
  productUser     ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  kind            String
  value           String
  normalizedValue String
  source          String
  createdAt       DateTime    @default(now())

  @@unique([productUserId, kind, normalizedValue])
  @@index([normalizedValue])
  @@index([normalizedValue(ops: raw("gin_trgm_ops"))], type: Gin, map: "productUserIdentity_normalizedValue_trgm_idx")
  @@map("productUserIdentity")
  @@schema("public")
}

model ProductOrganization {
  id                   String     @id @default(cuid())
  sourceId             String
  source               DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId           String
  name                 String?
  domain               String?
  plan                 String?
  paymentStatus        Json?
  stripeSubscriptionId String?
  stripeCustomerId     String?
  traits               Json
  syncedAt             DateTime
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  memberships  ProductOrganizationMembership[]
  companyLinks ProductOrganizationCompanyLink[]

  @@unique([sourceId, externalId])
  @@index([name])
  @@index([domain])
  @@index([stripeCustomerId])
  @@index([externalId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_externalId_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_name_trgm_idx")
  @@index([domain(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_domain_trgm_idx")
  @@index([stripeCustomerId(ops: raw("gin_trgm_ops"))], type: Gin, map: "productOrganization_stripeCustomerId_trgm_idx")
  @@map("productOrganization")
  @@schema("public")
}

model ProductOrganizationMembership {
  id                    String              @id @default(cuid())
  productUserId         String
  productUser           ProductUser         @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  productOrganizationId String
  productOrganization   ProductOrganization @relation(fields: [productOrganizationId], references: [id], onDelete: Cascade)
  role                  String?
  traits                Json?
  syncedAt              DateTime

  @@unique([productUserId, productOrganizationId])
  @@index([productOrganizationId])
  @@map("productOrganizationMembership")
  @@schema("public")
}

model ProductUserSnapshot {
  id             String      @id @default(cuid())
  idempotencyKey String      @unique
  sourceId       String
  source         DataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  productUserId  String
  productUser    ProductUser @relation(fields: [productUserId], references: [id], onDelete: Cascade)
  capturedAt     DateTime
  contentHash    String
  payload        Json
  createdAt      DateTime    @default(now())

  @@index([productUserId, capturedAt])
  @@index([sourceId, capturedAt])
  @@map("productUserSnapshot")
  @@schema("public")
}

model StripeCustomerBillingCountry {
